# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to GitHub.

PORT=5000

# Update user/password/database name to match what you created in pgAdmin/psql
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/smart_hostel_finder

# Any long random string — used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_secret_string

# ---------------------------------------------------------
# Email (for "Forgot password" reset links) — OPTIONAL.
# If left blank, reset links just print to this terminal instead —
# the app still works fine for local testing without this set up.
#
# To send real emails via your own Gmail account:
#   1. Turn on 2-Step Verification on that Google account (required)
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password (choose "Mail" as the app)
#   4. Paste the 16-character password below (NOT your normal Gmail password)
# ---------------------------------------------------------
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password

# ---------------------------------------------------------
# Paystack (for real deposit payments — card + Mobile Money) — REQUIRED
# for the booking payment flow to work at all.
#
#   1. Sign up free at https://dashboard.paystack.com/#/signup
#   2. Go to Settings -> API Keys & Webhooks
#   3. Copy the "Test Secret Key" (starts with sk_test_...)
#   4. Test mode does NOT move real money — safe to use freely for demos
# ---------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_your_test_secret_key_here
